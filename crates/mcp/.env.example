# MCP Server bind address (default: 127.0.0.1:3000)
MCP_SERVER_BIND_ADDRESS=127.0.0.1:3000

# REQUIRED: Path to wallet state JSON file
WALLET_PATH=/path/to/wallet_state.json

# REQUIRED: Sovereign SDK rollup RPC endpoint (must be http/https)
ROLLUP_RPC_URL=http://localhost:12346

# REQUIRED: Path to ZK circuit WASM program for proof generation
ZK_PROGRAM_PATH=/path/to/value_validator.wasm

