# Where the HTTP server listens
MIDNIGHT_FVK_SERVICE_BIND=127.0.0.1:8088

# SQLite connection string for persisted state (issued FVKs + monotonic counter).
MIDNIGHT_FVK_SERVICE_DB=sqlite://midnight_fvk_service.sqlite?mode=rwc

# 32-byte hex (optionally 0x-prefixed): secp256k1 signing secret key.
# This signs `fvk_commitment` (the Poseidon2 hash), so anyone can verify issuance with the public key.
MIDNIGHT_FVK_SERVICE_SIGNING_SK_HEX=

# 32-byte hex (optionally 0x-prefixed): root seed used to deterministically derive per-request FVKs.
MIDNIGHT_FVK_SERVICE_ROOT_FVK_SEED_HEX=

# Optional: last issued auto-index (u64). On startup we set `next_index >= last_issued_index + 1`;
# the largest value wins between DB and ENV.
MIDNIGHT_FVK_SERVICE_LAST_ISSUED_INDEX=

# If true, missing keys are generated in-memory at startup (not recommended for production).
MIDNIGHT_FVK_SERVICE_ALLOW_EPHEMERAL_KEYS=false
