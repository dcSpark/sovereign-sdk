# Makefile for rollup-nightstream

.PHONY: all build run clean help

# Paths
SOV_CLI_REL_PATH := ../../target/release/sov-cli
LOCAL_DA_PG_URL      ?= postgresql://admin:1234@localhost:5432/da
LOCAL_INDEXER_PG_URL ?= postgresql://admin:1234@localhost:5432/indexer
LOCAL_FVK_PG_URL     ?= postgresql://admin:1234@localhost:5432/fvk

all: build

## Build the rollup
build:
	@echo "Building rollup-nightstream..."
	@echo "Removing old autogenerated.rs to force regeneration..."
	@rm -f autogenerated.rs
	SKIP_GUEST_BUILD=1 cargo build -p sov-rollup-nightstream
	@echo "Build complete! Binary: target/debug/sov-rollup-nightstream"

## Build in release mode
build-release:
	@echo "Building rollup-nightstream (release)..."
	@rm -f autogenerated.rs
	SKIP_GUEST_BUILD=1 cargo build -p sov-rollup-nightstream --release
	@echo "Build complete! Binary: target/release/sov-rollup-nightstream"

## Run the rollup
run:
	./run_rollup.sh

## Clean build artifacts and local data
clean:
	@echo "Cleaning rollup-nightstream data..."
	rm -rf ./demo_data
	rm -rf ./nightstream-artifacts
	rm -f da.sqlite da.sqlite-shm da.sqlite-wal
	rm -f mock_da.sqlite
	rm -f wallet_index.sqlite
	@echo "Removing unsent transactions from local storage"
	@if [ -f "$(SOV_CLI_REL_PATH)" ]; then \
		$(SOV_CLI_REL_PATH) transactions clean || true; \
	fi
	@echo "Truncating local PostgreSQL tables (if configured)..."
	@set -eu; \
	if command -v psql >/dev/null 2>&1; then \
		truncate_pg_db() { \
			db_url="$$1"; \
			db_name="$$2"; \
			if [ -z "$$db_url" ]; then \
				return 0; \
			fi; \
			case "$$db_url" in \
				postgres://*|postgresql://*) ;; \
				*) \
					echo "  - skipping $$db_name (non-Postgres URL)"; \
					return 0; \
					;; \
			esac; \
			echo "  - truncating $$db_name"; \
			tables="$$(psql "$$db_url" -v ON_ERROR_STOP=1 -Atqc "SELECT string_agg(quote_ident(schemaname) || '.' || quote_ident(tablename), ', ') FROM pg_tables WHERE schemaname = 'public';" 2>/dev/null)" \
				|| { echo "    warning: failed to query $$db_name at $$db_url"; return 0; }; \
			if [ -n "$$tables" ]; then \
				psql "$$db_url" -v ON_ERROR_STOP=1 -q -c "TRUNCATE TABLE $$tables RESTART IDENTITY CASCADE;" >/dev/null \
					|| echo "    warning: failed to truncate $$db_name at $$db_url"; \
			fi; \
		}; \
		truncate_pg_db "$${DA_CONNECTION_STRING:-$(LOCAL_DA_PG_URL)}" "da"; \
		truncate_pg_db "$${INDEX_DB:-$(LOCAL_INDEXER_PG_URL)}" "indexer"; \
		truncate_pg_db "$${MIDNIGHT_FVK_SERVICE_DB:-$(LOCAL_FVK_PG_URL)}" "fvk"; \
	else \
		echo "  - skipping Postgres DB cleanup (psql not found)"; \
	fi
	@echo "Clean complete."

## Show help
help:
	@echo "Rollup Nightstream - Makefile Commands"
	@echo ""
	@echo "Usage:"
	@echo "  make build          Build the rollup binary (debug)"
	@echo "  make build-release  Build the rollup binary (release)"
	@echo "  make run            Run the rollup via run_rollup.sh"
	@echo "  make clean          Clean local data (demo_data, artifacts, Postgres tables)"
	@echo "  make help           Show this help message"
