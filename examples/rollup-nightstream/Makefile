# Makefile for rollup-nightstream

.PHONY: all build run clean help

# Paths
SOV_CLI_REL_PATH := ../../target/release/sov-cli

all: build

## Build the rollup
build:
	@echo "Building rollup-nightstream..."
	@echo "Removing old autogenerated.rs to force regeneration..."
	@rm -f autogenerated.rs
	SKIP_GUEST_BUILD=1 cargo build -p sov-rollup-nightstream
	@echo "Build complete! Binary: target/debug/sov-rollup-nightstream"

## Build in release mode
build-release:
	@echo "Building rollup-nightstream (release)..."
	@rm -f autogenerated.rs
	SKIP_GUEST_BUILD=1 cargo build -p sov-rollup-nightstream --release
	@echo "Build complete! Binary: target/release/sov-rollup-nightstream"

## Run the rollup
run:
	./run_rollup.sh

## Clean build artifacts and local data
clean:
	@echo "Cleaning rollup-nightstream data..."
	rm -rf ./demo_data
	rm -rf ./nightstream-artifacts
	rm -f da.sqlite da.sqlite-shm da.sqlite-wal
	rm -f mock_da.sqlite
	rm -f wallet_index.sqlite
	@echo "Removing unsent transactions from local storage"
	@if [ -f "$(SOV_CLI_REL_PATH)" ]; then \
		$(SOV_CLI_REL_PATH) transactions clean || true; \
	fi
	@echo "Clean complete."

## Show help
help:
	@echo "Rollup Nightstream - Makefile Commands"
	@echo ""
	@echo "Usage:"
	@echo "  make build          Build the rollup binary (debug)"
	@echo "  make build-release  Build the rollup binary (release)"
	@echo "  make run            Run the rollup via run_rollup.sh"
	@echo "  make clean          Clean local data (demo_data, SQLite DBs, artifacts)"
	@echo "  make help           Show this help message"
