[Unit]
Description=Sovereign SDK Ligero Replica Service Controller
After=network.target

[Service]
Type=simple
User=replace_for_linux_user
WorkingDirectory=/home/replace_for_linux_user/sovereign-sdk/examples/rollup-ligero
ExecStart=/usr/bin/env cargo run -p sov-rollup-ligero --bin rollup-ligero-service-controller --release
Restart=on-failure
Environment="PATH=/home/replace_for_linux_user/.cargo/bin:/usr/local/bin:/usr/bin:/bin"

# Auto-start replica on controller start
Environment="SERVICE_CONTROLLER_AUTO_START=1"
Environment="SERVICE_CONTROLLER_BIND=127.0.0.1:9090"

# Enable replica-only mode (all other services are implicitly remote)
Environment="START_REPLICA=1"

# Replica RPC URL (local, default port 12347)
Environment="REPLICA_RPC_URL=http://127.0.0.1:12347"

# PostgreSQL DA connection (shared with primary)
#Environment="DA_CONNECTION_STRING=postgresql://admin:1234@localhost:5432/da"

# ── Remote service URLs (for health-check dashboard) ──
# Uncomment and replace "primary-vm" with the primary node's IP/hostname.
#   Service        Env var                         Default (on primary)
#   ─────────      ──────────────────────────────  ────────────────────────
#   rollup         ROLLUP_RPC_URL                  http://127.0.0.1:12346
#   worker         BIND_ADDR                       http://127.0.0.1:8080
#   oracle         ORACLE_SERVER_BIND_ADDRESS      http://127.0.0.1:8090
#   fvk            MIDNIGHT_FVK_SERVICE_URL        http://127.0.0.1:8088
#   indexer        INDEXER_BIND                     http://127.0.0.1:13100
#   proof-pool     PROOF_POOL_BIND_ADDR            http://127.0.0.1:11235
#   mcp            MCP_SERVER_BIND_ADDRESS          http://127.0.0.1:3000
#   metrics        METRICS_API_BIND                http://127.0.0.1:13200
#
#Environment="ROLLUP_RPC_URL=http://primary-vm:12346"
#Environment="BIND_ADDR=http://primary-vm:8080"
#Environment="ORACLE_SERVER_BIND_ADDRESS=http://primary-vm:8090"
#Environment="MIDNIGHT_FVK_SERVICE_URL=http://primary-vm:8088"
#Environment="INDEXER_BIND=http://primary-vm:13100"
#Environment="PROOF_POOL_BIND_ADDR=http://primary-vm:11235"
#Environment="MCP_SERVER_BIND_ADDRESS=http://primary-vm:3000"
#Environment="METRICS_API_BIND=http://primary-vm:13200"

[Install]
WantedBy=multi-user.target
